---
import Socials from "@components/Socials.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import { getEntry, render } from "astro:content";

const bioIntro = await getEntry("about", "blurb");
if (!bioIntro) {
  throw new Error("Bio intro content not found");
}
const { Content: BlurbContent } = await render(bioIntro);


---

<ContentLayout
  banner="orion"
  title="Lucas Barbosa"
  ogTitle="Lucas Barbosa - Software, AI, and Life"
  ogDescription="Thoughtful essays on software engineering, AI, startups, and personal growth. Explore ideas, practical lessons, and experiments."
  url="/"
  type="profile"
>
  <section class="blog-content content mt-2xl mb-xl">
      <BlurbContent />
  </section>
  <section class="mb-3xl">
    <Socials />
  </section>
</ContentLayout>
