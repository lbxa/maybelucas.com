---
import ContentLayout from "@layouts/ContentLayout.astro";
import { getEntry, render } from "astro:content";

const works = await getEntry("research", "works");
if (!works) {
  throw new Error("Research works content not found");
}
const { Content: WorksContent } = await render(works);
---

<ContentLayout title="Research" banner="orion">
  <section class="mb-xl">
    <h1>Research</h1>
    <section class="research-content blog-content content">
      <WorksContent />
    </section>
  </section>
</ContentLayout>

<style>
  .research-content :global(h2) {
    font: inherit;
    letter-spacing: inherit;
    margin: 0 0 1.25rem;
  }

  .research-content > :global(ul + h2) {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  .research-content > :global(ul) {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .research-content > :global(ul > li) {
    margin: 0;
  }

  .research-content > :global(ul > li::marker) {
    color: transparent;
  }

  .research-content :global(li > p) {
    margin: 0;
    text-wrap: pretty;
  }

  .research-content :global(li > p + p) {
    margin-top: 0.375rem;
    font-size: 0.875rem;
  }

  @media (min-width: 40rem) {
    .research-content > :global(#interests + ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
