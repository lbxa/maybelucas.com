---
import { Icon } from "astro-icon/components";
import poster from "@/assets/images/coastal-poppies-poster.webp";
import videoUrl from "@/assets/animations/coastal-poppies.mp4?url";
---

<details class="coastal-poppies-banner relative z-20">
  <summary aria-label="Coastal poppy animation">
    <video
      data-coastal-poppies-video
      data-src={videoUrl}
      poster={poster.src}
      title="Coastal poppies in bloom"
      preload="none"
      muted
      playsinline
      width="640"
      height="360"
      tabindex="-1"
      aria-hidden="true"
    ></video>
    <span
      class="banner-action rounded-2xl border border-shark-200/70 bg-ivory/70 text-shark-900 backdrop-blur-md hover:bg-ivory/95 dark:border-shark-700/70 dark:bg-shark-950/70 dark:text-ivory dark:hover:bg-shark-950/95"
      aria-hidden="true"
    >
      <span class="expand-icon">
        <Icon name="expand" size={16} class="fill-current" aria-hidden="true" focusable="false" />
      </span>
      <span class="collapse-icon">
        <Icon name="compress" size={16} class="fill-current" aria-hidden="true" focusable="false" />
      </span>
    </span>
  </summary>
</details>

<script>
  const initializedVideos = new WeakSet<HTMLVideoElement>();

  function initializeCoastalPoppies() {
    const video = document.querySelector<HTMLVideoElement>("[data-coastal-poppies-video]");
    const banner = video?.closest("details");
    const source = video?.dataset.src;
    if (!video || !banner || !source || initializedVideos.has(video)) return;
    initializedVideos.add(video);

    const controller = new AbortController();
    const { signal } = controller;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const connection = "connection" in navigator ? navigator.connection : undefined;
    const saveData = connection && typeof connection === "object" &&
      "saveData" in connection && connection.saveData === true;
    let visible = !("IntersectionObserver" in window);
    let ready = false;
    let idleId: number | undefined;
    let timeoutId: number | undefined;

    const updatePlayback = () => {
      if (!ready || !visible || document.hidden || reducedMotion.matches || saveData) {
        video.pause();
        return;
      }
      if (video.ended) return;
      if (!video.hasAttribute("src")) video.src = source;
      if (video.paused) {
        // Autoplay restrictions leave the lightweight poster visible.
        void video.play().catch(() => {});
      }
    };

    const allowPlayback = () => {
      ready = true;
      updatePlayback();
    };

    const queuePlayback = () => {
      if (typeof window.requestIdleCallback === "function") {
        idleId = window.requestIdleCallback(allowPlayback, { timeout: 2000 });
      } else {
        timeoutId = window.setTimeout(allowPlayback, 200);
      }
    };

    const observer = "IntersectionObserver" in window
      ? new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          updatePlayback();
        }, { threshold: 0.01 })
      : undefined;
    observer?.observe(video);
    document.addEventListener("visibilitychange", updatePlayback, { signal });
    reducedMotion.addEventListener("change", updatePlayback, { signal });
    // An intentional click can also start playback if browser autoplay was blocked.
    banner.addEventListener("click", allowPlayback, { signal });

    if (document.readyState === "complete") queuePlayback();
    else window.addEventListener("load", queuePlayback, { once: true, signal });

    document.addEventListener("astro:before-swap", () => {
      controller.abort();
      observer?.disconnect();
      if (idleId !== undefined) window.cancelIdleCallback(idleId);
      if (timeoutId !== undefined) window.clearTimeout(timeoutId);
      video.pause();
      video.removeAttribute("src");
      video.load();
      initializedVideos.delete(video);
    }, { once: true, signal });
  }

  document.addEventListener("astro:page-load", initializeCoastalPoppies);
</script>

<style>
  summary {
    position: relative;
    display: block;
    height: clamp(12rem, 25vw, 15rem);
    overflow: hidden;
    background: #cbd7db;
    cursor: zoom-in;
    list-style: none;
    transition: height 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: none;
  }

  summary:focus-visible .banner-action {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    image-rendering: pixelated;
    pointer-events: none;
  }

  .banner-action {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .collapse-icon,
  .coastal-poppies-banner[open] .expand-icon {
    display: none;
  }

  .coastal-poppies-banner[open] .collapse-icon {
    display: inline;
  }

  .coastal-poppies-banner[open] summary {
    height: 100svh;
    cursor: zoom-out;
  }

  @media (prefers-reduced-motion: reduce) {
    summary,
    .banner-action {
      transition: none;
    }
  }
</style>
