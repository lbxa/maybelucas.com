---
import Footer from "@components/Footer.astro";
import PaintingBanner from "@components/PaintingBanner.astro";
import RootLayout from "@layouts/RootLayout.astro";
import type { ComponentProps } from "astro/types";
import type { BannerName } from "@/lib/bannerImages";

type Props = ComponentProps<typeof RootLayout> & {
  banner?: BannerName;
};

const { title, banner, ...seoProps } = Astro.props;
---

<RootLayout title={title} {...seoProps}>
  <slot name="background" />

  <div
    class="fixed inset-0 backdrop-blur-md bg-ivory/60 dark:bg-shark-950/60 md:bg-ivory/65 md:dark:bg-shark-950/80 z-10 pointer-events-none"
  >
  </div>

  {banner && <PaintingBanner painting={banner} />}

  <main
    class:list={[
      "flex flex-col mx-auto px-lg md:px-0 max-w-screen-sm min-h-dvh relative z-20",
      !banner && "pt-20",
    ]}
  >
    <article class="grow">
      <slot />
    </article>
    <Footer />
  </main>
</RootLayout>
